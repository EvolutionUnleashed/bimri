{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "__BIMRI_VERIFIED_PYTHON__",
            "args": [
              "${CLAUDE_PROJECT_DIR}/bimri-engine.py",
              "hook-start"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "__BIMRI_VERIFIED_PYTHON__",
            "args": [
              "${CLAUDE_PROJECT_DIR}/bimri-engine.py",
              "hook-close"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
